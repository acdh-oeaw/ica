{
	"name": "@acdh-oeaw/ica-website",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"analyze": "next analyze",
		"build": "next build",
		"dev": "next dev",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"generate:db": "tsx ./scripts/generate-db.ts",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:code:check": "oxlint --report-unused-disable-directives --type-aware --type-check",
		"lint:code:fix": "pnpm run lint:code:check --fix",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:styles:check": "stylelint \"./**/*.css\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "pnpm run lint:styles:check --fix",
		"preinstall": "npx only-allow pnpm",
		"prepare": "pnpm run types:prepare",
		"start": "next start",
		"test:e2e": "playwright test --pass-with-no-tests",
		"test:e2e:codegen": "playwright codegen",
		"test:e2e:install": "playwright install --with-deps",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:update-snapshots": "playwright test --update-snapshots",
		"test:e2e:update-snapshots:ci": "node ./scripts/update-snapshots.ts",
		"types:check": "tsc --noEmit",
		"types:prepare": "next typegen",
		"validate": "run-p format:check lint:check types:check test:e2e"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^1.0.7",
		"@acdh-oeaw/style-variants": "^0.1.0",
		"@acdh-oeaw/validate-env": "^0.0.3",
		"@react-aria/utils": "^3.34.1",
		"client-only": "^0.0.1",
		"clsx": "^2.1.1",
		"d3": "^7.9.2",
		"fast-glob": "^3.3.3",
		"force-graph": "^1.52.0",
		"image-dimensions": "^2.6.0",
		"lucide-react": "^1.73.0",
		"maplibre-gl": "^6.18.0",
		"markdown-it": "^15.0.3",
		"next": "^16.4.5",
		"next-intl": "^4.15.1",
		"react": "^19.3.1",
		"react-aria": "^3.53.1",
		"react-aria-components": "^1.22.1",
		"react-dom": "^19.3.1",
		"react-map-gl": "^8.1.3",
		"react-schemaorg": "^2.0.1",
		"react-stately": "^3.51.0",
		"server-only": "^0.0.1",
		"sharp": "^0.35.5",
		"swr": "^2.5.1",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@react-aria/optimize-locales-plugin": "^2.1.0",
		"@react-types/shared": "^3.37.0",
		"@tailwindcss/turbopack": "^4.3.5",
		"@tailwindcss/typography": "^0.5.20",
		"@types/d3": "^7.4.3",
		"@types/geojson": "^7946.0.16",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/serialize-javascript": "^5.0.4",
		"axe-core": "^4.14.0",
		"axe-playwright": "^2.2.2",
		"ci-info": "^4.5.0",
		"dotenv": "^18.0.10",
		"dotenv-expand": "^1000.0.0",
		"eslint-plugin-check-file": "^3.3.2",
		"eslint-plugin-playwright": "^2.12.2",
		"lefthook": "^2.2.2",
		"npm-run-all2": "^9.0.4",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.92.0",
		"oxlint-tsgolint": "^7.0.2006",
		"schema-dts": "^2.1.0",
		"serialize-javascript": "^7.1.4",
		"stylelint": "^18.0.0",
		"stylelint-order": "^8.1.3",
		"tailwindcss": "^4.3.5",
		"tailwindcss-animate": "^1.0.7",
		"tailwindcss-react-aria-components": "^2.2.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"stylelint": {
		"extends": "./config/stylelint/base.json"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.21.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "^26"
	}
}
